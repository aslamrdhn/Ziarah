rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.email == 'aslamramadhan08@gmail.com';
    }

    match /users/{userId} {
      allow read: if isOwner(userId);
      // Simplify write rules to prevent race conditions during React hydration, 
      // while still strictly enforcing ownership and UID matching.
      allow write: if isOwner(userId) && request.resource.data.userId == userId;
    }

    match /sites/{siteId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
