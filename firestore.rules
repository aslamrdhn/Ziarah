rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isBootstrapOwner() {
      return isSignedIn() &&
        request.auth.token.email == 'aslamramadhan08@gmail.com' &&
        request.auth.token.email_verified == true;
    }

    function isAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        isBootstrapOwner()
      );
    }

    function isValidContribution(data) {
      return data.type in ['baru', 'karomah', 'doa'] &&
        data.contributorName is string && data.contributorName.size() >= 1 && data.contributorName.size() <= 100 &&
        data.targetName is string && data.targetName.size() >= 1 && data.targetName.size() <= 150 &&
        data.content is string && data.content.size() >= 3 && data.content.size() <= 3000 &&
        data.status in ['pending', 'approved', 'rejected'];
    }

    function isValidStory(data) {
      return data.keys().hasAll(['siteId', 'authorName', 'text']) &&
        data.keys().hasOnly(['siteId', 'authorName', 'authorUid', 'text', 'status', 'createdAt']) &&
        data.siteId is string && data.siteId.size() >= 1 && data.siteId.size() <= 128 &&
        data.authorName is string && data.authorName.size() >= 1 && data.authorName.size() <= 100 &&
        data.text is string && data.text.size() >= 3 && data.text.size() <= 1000 &&
        (!('authorUid' in data) || (data.authorUid is string && data.authorUid.size() <= 128)) &&
        (!('status' in data) || data.status in ['pending', 'approved', 'published']);
    }

    function isValidDonation(data) {
      return data.programId is string && data.programId.size() >= 1 && data.programId.size() <= 100 &&
        data.amount is number && data.amount >= 5000 && data.amount <= 1000000000 &&
        data.donorName is string && data.donorName.size() >= 1 && data.donorName.size() <= 100 &&
        data.hasProof == true &&
        !('proofImageUrl' in data) &&
        data.status in ['pending', 'confirmed', 'verified', 'rejected'];
    }

    function isValidDonationProof(data) {
      return data.donationId is string && data.donationId.size() >= 1 && data.donationId.size() <= 128 &&
        data.senderAccount is string && data.senderAccount.size() >= 2 && data.senderAccount.size() <= 100 &&
        data.proofImageUrl is string && data.proofImageUrl.size() >= 500 && data.proofImageUrl.size() <= 500000;
    }

    match /admins/{adminUid} {
      allow get: if isSignedIn() && (request.auth.uid == adminUid || isAdmin());
      allow list: if isAdmin();
      allow create, update: if isValidId(adminUid) && (
        isAdmin() ||
        (request.auth.uid == adminUid && isBootstrapOwner())
      );
      allow delete: if isAdmin() && isValidId(adminUid);
    }

    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create, update: if isOwner(userId) && isValidId(userId) && incoming().userId == userId;
      allow delete: if isOwner(userId) && isValidId(userId);
    }

    match /sites/{siteId} {
      allow read: if true;
      allow create, update, delete: if isAdmin() && isValidId(siteId);
    }

    match /contributions/{contributionId} {
      allow get: if isValidId(contributionId) && (isAdmin() || existing().status == 'approved' || (isSignedIn() && existing().authorUid == request.auth.uid));
      allow list: if isAdmin() || existing().status == 'approved' || (isSignedIn() && existing().authorUid == request.auth.uid);
      allow create: if isValidId(contributionId) && isValidContribution(incoming()) && incoming().status == 'pending';
      allow update: if isAdmin() && isValidId(contributionId) && isValidContribution(incoming());
      allow delete: if isAdmin() && isValidId(contributionId);
    }

    match /stories/{storyId} {
      allow read: if true;
      allow create: if isValidId(storyId) && isValidStory(incoming()) && (!('status' in incoming()) || incoming().status in ['pending', 'published']);
      allow update: if isAdmin() && isValidId(storyId) && isValidStory(incoming());
      allow delete: if isAdmin() && isValidId(storyId);
    }

    match /donations/{donationId} {
      allow read: if true;
      allow create: if isValidId(donationId) && isValidDonation(incoming()) && incoming().status in ['pending', 'confirmed'];
      allow update: if isAdmin() && isValidId(donationId);
      allow delete: if isAdmin() && isValidId(donationId);

      match /private/{docId} {
        allow get: if isAdmin() || (isSignedIn() && existing().authorUid == request.auth.uid);
        allow list: if isAdmin();
        allow create: if isValidId(donationId) && docId == 'proof' && isValidDonationProof(incoming()) && incoming().donationId == donationId;
        allow update, delete: if isAdmin() && isValidId(donationId);
      }
    }

    match /settings/{settingId} {
      allow read: if true;
      allow create, update, delete: if isAdmin() && isValidId(settingId);
    }
  }
}
