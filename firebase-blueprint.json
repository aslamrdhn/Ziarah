{
  "entities": {
    "UserProfile": {
      "title": "User Profile",
      "description": "Stores user preferences like saved sites, doas, rubrik articles, and unlocked stories.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "The UID of the user."
        },
        "savedSiteIds": {
          "type": "array",
          "description": "List of saved site IDs"
        },
        "savedDoas": {
          "type": "array",
          "description": "List of saved doa IDs"
        },
        "savedRubrik": {
          "type": "array",
          "description": "List of saved rubrik article IDs"
        },
        "unlockedUntold": {
          "type": "array",
          "description": "List of unlocked untold story site IDs"
        },
        "createdAt": {
          "type": "string",
          "description": "Timestamp of creation."
        },
        "updatedAt": {
          "type": "string",
          "description": "Timestamp of last update."
        }
      },
      "required": ["userId"]
    },
    "ZiarahSite": {
      "title": "Ziarah Site",
      "description": "Information about a Ziarah site.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "location": { "type": "object" },
        "category": { "type": "string" },
        "imageUrl": { "type": "string" },
        "history": { "type": "string" },
        "facilities": { "type": "array" },
        "openingHours": { "type": "string" },
        "karomah": { "type": "array" },
        "doaKhusus": { "type": "array" },
        "untoldStory": { "type": "string" },
        "haulSchedule": { "type": "string" },
        "localAdab": { "type": "string" }
      },
      "required": ["id", "name", "title", "category"]
    },
    "Contribution": {
      "title": "Community Contribution",
      "description": "User-submitted makam, rubrik/karomah, or doa khusus awaiting curator verification.",
      "type": "object",
      "properties": {
        "type": { "type": "string", "enum": ["baru", "karomah", "doa"] },
        "contributorName": { "type": "string", "maxLength": 100 },
        "contributorContact": { "type": "string", "maxLength": 120 },
        "targetName": { "type": "string", "maxLength": 150 },
        "category": { "type": "string", "maxLength": 80 },
        "city": { "type": "string", "maxLength": 100 },
        "province": { "type": "string", "maxLength": 100 },
        "mapsUrl": { "type": "string", "maxLength": 500 },
        "content": { "type": "string", "maxLength": 3000 },
        "translation": { "type": "string", "maxLength": 1500 },
        "status": { "type": "string", "enum": ["pending", "approved", "rejected"] },
        "authorUid": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string" }
      },
      "required": ["type", "contributorName", "targetName", "content", "status"]
    },
    "VisitorStory": {
      "title": "Visitor Story",
      "description": "Pilgrim testimonial and spiritual experience at a specific Ziarah site.",
      "type": "object",
      "properties": {
        "siteId": { "type": "string", "maxLength": 128 },
        "authorName": { "type": "string", "maxLength": 100 },
        "authorUid": { "type": "string", "maxLength": 128 },
        "text": { "type": "string", "maxLength": 1000 },
        "status": { "type": "string", "enum": ["pending", "approved", "published"] },
        "createdAt": { "type": "string" }
      },
      "required": ["siteId", "authorName", "text"]
    },
    "InfaqDonation": {
      "title": "Infaq Donation",
      "description": "Recorded infaq pledge and prayer (doa hajat) from pilgrims (lightweight public metadata without raw receipt image).",
      "type": "object",
      "properties": {
        "programId": { "type": "string", "maxLength": 100 },
        "programTitle": { "type": "string", "maxLength": 150 },
        "siteId": { "type": "string", "maxLength": 128 },
        "siteName": { "type": "string", "maxLength": 150 },
        "amount": { "type": "number" },
        "donorName": { "type": "string", "maxLength": 100 },
        "paymentMethod": { "type": "string", "maxLength": 40 },
        "hasProof": { "type": "boolean" },
        "referenceCode": { "type": "string", "maxLength": 40 },
        "doaHajat": { "type": "string", "maxLength": 1000 },
        "authorUid": { "type": "string", "maxLength": 128 },
        "consentAkad": { "type": "boolean" },
        "consentVersion": { "type": "string", "maxLength": 40 },
        "consentAt": { "type": "string", "maxLength": 64 },
        "status": { "type": "string", "enum": ["pending", "confirmed", "verified", "rejected"] },
        "createdAt": { "type": "string" }
      },
      "required": ["programId", "amount", "donorName", "hasProof", "consentAkad", "status"]
    },
    "InfaqDonationProof": {
      "title": "Private Infaq Donation Proof",
      "description": "Private subcollection document storing compressed transfer receipt image and sender bank account name, readable only by Admin Curators.",
      "type": "object",
      "properties": {
        "donationId": { "type": "string", "maxLength": 128 },
        "senderAccount": { "type": "string", "maxLength": 100 },
        "proofImageUrl": { "type": "string", "maxLength": 500000 },
        "referenceCode": { "type": "string", "maxLength": 40 },
        "fileName": { "type": "string", "maxLength": 160 },
        "sizeKb": { "type": "number" },
        "authorUid": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string" }
      },
      "required": ["donationId", "senderAccount", "proofImageUrl"]
    },
    "AdminRecord": {
      "title": "Curator Admin Record",
      "description": "Stores verified Admin Curator UIDs for role-based access control.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "maxLength": 160 },
        "role": { "type": "string", "enum": ["admin", "superadmin"] },
        "updatedAt": { "type": "string" }
      },
      "required": ["uid", "email", "role"]
    },
    "AppSettings": {
      "title": "Application Settings",
      "description": "Configurable settings for self-hosting such as bank account details, official QRIS image, customizable Infaq programs, ordered donation tiers, and WhatsApp confirmation template.",
      "type": "object",
      "properties": {
        "bankName": { "type": "string", "maxLength": 100 },
        "accountNumber": { "type": "string", "maxLength": 60 },
        "accountHolder": { "type": "string", "maxLength": 120 },
        "qrisImageUrl": { "type": "string", "maxLength": 1000 },
        "qrisPayload": { "type": "string", "maxLength": 1000 },
        "donationTiers": {
          "type": "array",
          "description": "Ordered fixed QRIS donation nominal tiers with labels and optional per-tier QRIS overrides."
        },
        "whatsappConfirmNumber": { "type": "string", "maxLength": 32 },
        "whatsappMessageTemplate": { "type": "string", "maxLength": 1000 },
        "customDomain": { "type": "string", "maxLength": 120 },
        "programs": {
          "type": "array",
          "description": "Customizable list of Infaq programs managed by the curator."
        },
        "rubrikGate": {
          "type": "object",
          "description": "Configuration for the Rubrik donation gate, free sample count, and custom curator articles."
        },
        "updatedAt": { "type": "string" }
      }
    },
    "LingkarDoaEntry": {
      "title": "Lingkar Doa Jumat Malam Entry",
      "description": "Real attendance and short prayer note for a weekly Friday night collective prayer session.",
      "type": "object",
      "properties": {
        "weekKey": { "type": "string", "minLength": 6, "maxLength": 16 },
        "displayName": { "type": "string", "minLength": 1, "maxLength": 60 },
        "note": { "type": "string", "maxLength": 160 },
        "createdAt": { "type": "string" }
      },
      "required": ["weekKey", "displayName", "createdAt"]
    }
  },
  "firestore": {
    "admins/{adminUid}": {
      "schema": { "$ref": "#/entities/AdminRecord" },
      "description": "Verified curator admin UIDs."
    },
    "users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "User profiles and synced preferences."
    },
    "sites/{siteId}": {
      "schema": { "$ref": "#/entities/ZiarahSite" },
      "description": "Public Ziarah sites directory."
    },
    "contributions/{contributionId}": {
      "schema": { "$ref": "#/entities/Contribution" },
      "description": "Community contributions queue for curator review."
    },
    "stories/{storyId}": {
      "schema": { "$ref": "#/entities/VisitorStory" },
      "description": "Public visitor stories and testimonials per site."
    },
    "donations/{donationId}": {
      "schema": { "$ref": "#/entities/InfaqDonation" },
      "description": "Public lightweight infaq logs and donor prayers."
    },
    "donations/{donationId}/private/{docId}": {
      "schema": { "$ref": "#/entities/InfaqDonationProof" },
      "description": "Private transfer receipt proof accessible only to Admin Curators."
    },
    "settings/{settingId}": {
      "schema": { "$ref": "#/entities/AppSettings" },
      "description": "Global configuration settings managed by Admin."
    },
    "lingkar_doa_entries/{entryId}": {
      "schema": { "$ref": "#/entities/LingkarDoaEntry" },
      "description": "Weekly Friday night prayer circle attendance entries."
    }
  }
}
